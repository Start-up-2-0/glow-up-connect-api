{
  "Database": {
    "Provider": "MySQL"
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Port=3306;Database=glowapi_db;User=root;Password=;"
  },
  "Mensageria": {
    "Habilitado": true,
    "TamanhoLote": 10,
    "IntervaloProcessamentoMs": 2000,
    "MaximoTentativasPadrao": 5,
    "BackoffBaseSegundos": 30,
    "BackoffMaximoSegundos": 3600,
    "TimeoutProcessamentoMinutos": 15,
    "IntervaloRecuperacaoMs": 60000,
    "InstanciaWorkerPrefixo": "glow-worker",
    "MascararDadosSensiveisEmLogs": true
  },
  "Mensageria:Email": {
    "Provedor": "resend",
    "Habilitado": false
  },
  "Mensageria:WhatsApp": {
    "ApiUrl": "",
    "ApiKey": "",
    "InstanceName": "",
    "NumeroPlataforma": "",
    "Habilitado": false
  },
  "Mensageria:Sms": {
    "ApiUrl": ""
  },
  "Auth": {
    "MaxLoginAttempts": 5,
    "LockoutMinutes": 15,
    "SessionMinutes": 15,
    "RefreshTokenDays": 7,
    "SlidingRenewalMinutes": 30,
    "ValidateIpOnToken": false,
    "ValidateUserAgentOnToken": false,
    "TokenSalt": "glow-dev-token-salt-min-32-chars!!",
    "TokenHeaderName": "x-glow-token",
    "ConfirmacaoEmailHoras": 24,
    "ConfirmacaoWhatsAppHoras": 24,
    "ConfirmacaoCodigoDigitos": 6,
    "FrontendBaseUrl": "http://localhost:5173"
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173",
      "http://localhost:3000"
    ]
  },
  "RateLimit": {
    "Enabled": true,
    "BurstMaxRequests": 80,
    "BurstWindowSeconds": 60,
    "BurstPenaltySeconds": 30,
    "HardBlockMultiplier": 5,
    "BlockDurationHours": 24,
    "ExemptAuthenticatedRequests": false,
    "SensitiveMaxRequests": 15,
    "SensitiveWindowSeconds": 900,
    "SensitivePenaltySeconds": 60,
    "SensitiveHardBlockMultiplier": 4
  },
  "ProxyOrigin": {
    "WebhookPathPrefix": "/api/webhooks",
    "HealthPath": "/health"
  },
  "Mtls": {
    "Enabled": false,
    "PublicPort": 8080,
    "MutualTlsPort": 8443
  },
  "Captcha": {
    "Enabled": false,
    "Provider": "Recaptcha",
    "SecretKey": "",
    "MinimumScore": 0.5
  },
  "Swagger": {
    "AccessKey": ""
  },
  "Avatar": {
    "MaxSizeBytes": 5242880,
    "TiposPermitidos": ["image/jpeg", "image/png", "image/webp"]
  },
  "MercadoPago": {
    "AccessToken": "",
    "WebhookSecret": "",
    "ApiBaseUrl": "https://api.mercadopago.com",
    "NotificationUrl": "",
    "SuccessUrl": "",
    "FailureUrl": "",
    "PendingUrl": "",
    "PayerEmailOverride": ""
  },
  "Geocodificacao:Nominatim": {
    "BaseUrl": "https://nominatim.openstreetmap.org",
    "UserAgent": "GlowUpConnectAPI/1.0 (dev@glowupconnect.local)",
    "PaisPadrao": "br",
    "TimeoutSegundos": 5
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
